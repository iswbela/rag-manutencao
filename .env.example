# ---------------------------------------------------------------------------
# Onde o indice vive.
#
#   sqlite   - padrao. Nao precisa instalar nada: FTS5 para a busca textual e
#              cosseno em numpy para a vetorial. Serve ate a casa das dezenas de
#              milhares de trechos, que cobre uma base de manuais real.
#   postgres - caminho de producao, com pgvector e indice HNSW. Precisa do
#              servidor de pe (docker compose up -d).
#
# A interface e a mesma nos dois: trocar aqui e reindexar e tudo o que muda.
# ---------------------------------------------------------------------------
BACKEND=sqlite
SQLITE_PATH=data/indice.sqlite3
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# ---------------------------------------------------------------------------
# Embeddings: modelo aberto, roda localmente na CPU, sem custo por requisicao.
# Se trocar o modelo, ajuste EMBEDDING_DIM e reindexe do zero: vetores de
# modelos diferentes vivem em espacos distintos e nao sao comparaveis.
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# ---------------------------------------------------------------------------
# Geracao de texto: qualquer endpoint compativel com o formato
# /v1/chat/completions (servico em nuvem com camada gratuita ou um servidor
# rodando na sua maquina). Deixe em branco para usar o projeto em modo
# somente-busca: /buscar continua funcionando, /perguntar retorna 503.
# ---------------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURA=0.1
LLM_TIMEOUT_S=60

# ---------------------------------------------------------------------------
# Recuperacao
# ---------------------------------------------------------------------------
TOP_K=5
CANDIDATOS_POR_VIA=20
CHUNK_ALVO_CHARS=1600
CHUNK_OVERLAP_CHARS=250

# ---------------------------------------------------------------------------
# Camadas de recuperacao. Os valores abaixo vieram de medicao com 40 perguntas
# (tabela no README); se mudar algum, rode scripts/avaliar.py antes e depois.
#
# FILTRO_EQUIPAMENTO  - restringe a busca ao equipamento citado na pergunta.
#                       Documentos validos para a frota toda continuam
#                       visiveis. +3 ms, zero exclusoes indevidas em 40
#                       perguntas: vem ligado.
# RERANKER_HABILITADO - reordena os candidatos com um cross-encoder. E o maior
#                       ganho medido (recall@1 de 0,78 para 0,97), mas custa
#                       cerca de 1 s por pergunta em CPU e baixa 470 MB no
#                       primeiro uso. Vem desligado: ligue se 1 s couber no
#                       seu orcamento de latencia.
# CANDIDATOS_RERANKER - quantos candidatos o cross-encoder reordena. Medido:
#                       5, 10 e 20 deram o MESMO recall e 20 custou 4x mais.
#                       Suba junto com TOP_K, e so com base em medicao nova.
# ---------------------------------------------------------------------------
FILTRO_EQUIPAMENTO=true
RERANKER_HABILITADO=false
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
CANDIDATOS_RERANKER=10
